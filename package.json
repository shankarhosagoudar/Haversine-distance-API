{
  "name": "haversine-distance-api",
  "version": "1.0.0",
  "description": "REST API to calculate great-circle distance using the Haversine formula",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "haversine",
    "distance",
    "api",
    "fastify",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "fastify": "^5.2.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@fastify/rate-limit": "^10.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}